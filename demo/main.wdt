namespace demo;

// alias i32 = int;
// alias f32 = float;

<*
fn int add(int x = 10, int y = 20)
{
    return x + y;
}

var int a = add();          // uses both defaults: add(10, 20) = 30
var int b = add(5);         // positional: add(5, 20) = 25
var int c = add(, 100);     // skip first: add(10, 100) = 110
var int d = add(, 50);    // named: add(10, 50) = 60

return a + b + c + d;       // 30 + 25 + 110 + 60 = 225
*>

fn int fibonacci(int n)
{
    if (n <= 1)
    {
        return n;
    }

    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn int fibonacci2(int n)
{
    var int a = 0;
    var int b = 1;
    for var int i = 0; i < n; i++
    {
        var int temp = b;
        b = a + b;
        a = temp;
    }
    return a;
}

return fibonacci2(5);

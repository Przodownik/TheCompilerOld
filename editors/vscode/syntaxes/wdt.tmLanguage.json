{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Wandelt",
	"scopeName": "source.wdt",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#constants" },
		{ "include": "#numbers" },
		{ "include": "#functions" },
		{ "include": "#operators" },
		{ "include": "#punctuation" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.wdt",
					"match": "//.*$"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.wdt",
					"match": "\\b(fn|return|namespace|var|as)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.wdt",
					"match": "\\b(bool|char|uchar|short|ushort|int|uint|long|ulong|float|double)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.wdt",
					"match": "\\b(true|false)\\b"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.wdt",
					"match": "\\b\\d+\\.\\d*[fd]|\\b\\d*\\.\\d+[fd]|\\b\\d+[fd]"
				},
				{
					"name": "constant.numeric.integer.wdt",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.wdt",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.wdt",
					"match": "[+\\-*/=]"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.terminator.wdt",
					"match": ";"
				},
				{
					"name": "punctuation.section.braces.begin.wdt",
					"match": "\\{"
				},
				{
					"name": "punctuation.section.braces.end.wdt",
					"match": "\\}"
				},
				{
					"name": "punctuation.section.parens.begin.wdt",
					"match": "\\("
				},
				{
					"name": "punctuation.section.parens.end.wdt",
					"match": "\\)"
				},
				{
					"name": "punctuation.accessor.dot.wdt",
					"match": "\\."
				}
			]
		}
	}
}
